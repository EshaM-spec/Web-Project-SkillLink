<html>
<body>
    <section style="background-color:#F7F5EF; min-height:850px; padding-top:100px;">

        <div style="background-color:white; width:400px;"
             class="mx-auto">
            <h2 class="d-flex flex-row justify-content-center pt-2" style="color:#183B32">LOGIN </h2>
            <div class="form-field pt-20">
                <label class="form-label ms-2" style="color:#183B32; font-size:18px; font-weight:bold;">Email address</label>
                <input type="email" class="form-control" placeholder="name@example.com">
                <label class="form-label ms-2" style="color:#183B32; font-size:18px; font-weight:bold;">Password</label>
                <input type="password" class="form-control " placeholder="xxxxxxxx">
                <label class="form-label ms-2" style="color:#183B32; font-size:18px; font-weight:bold;">Service Name</label>
                <input type="text" class="form-control " placeholder="Electrician">
                <label class="form-label ms-2" style="color:#183B32; font-size:18px; font-weight:bold;">Contact Number</label>
                <input type="number" class="form-control " placeholder="123456789">
                <label class="form-label ms-2" style="color:#183B32; font-size:18px; font-weight:bold;">City</label>
                <input type="text" class="form-control " placeholder="xyz">

                <div class="d-flex">
                    <button type="button" class="btn btn-primary ms-auto mt-4 mb-3">
                        Sign Up
                    </button>
                </div>
            </div>
        </div>

    </section>
</body>
</html>
